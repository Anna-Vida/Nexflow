generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workflow {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @default("Untitled workflow")
  currentVersion Int               @default(0)
  webhookToken   String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  versions       WorkflowVersion[]
  executions     Execution[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model WorkflowVersion {
  id         String    @id @default(uuid()) @db.Uuid
  workflowId String    @db.Uuid
  version    Int

  nodes      Json
  edges      Json

  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
}

model Execution {
  id          String           @id @db.Uuid
  workflowId  String?          @db.Uuid

  status      String           @default("RUNNING")

  nodes       Json
  edges       Json
  input       Json
  context     Json?

  startNodeId  String?
  attemptCount Int @default(0)
  maxAttempts  Int @default(1)
  lastError    String?

  retriedFromId String? @db.Uuid
  retriedFrom Execution? @relation("ExecutionRetries", fields: [retriedFromId], references: [id], onDelete: SetNull)
  retries Execution[] @relation("ExecutionRetries")

  message     String?
  durationMs  Int?

  workflow    Workflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  events      ExecutionEvent[]
  httpActions HttpAction[]

  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([workflowId, startedAt])
}

model ExecutionEvent {
  id          String      @id @default(uuid()) @db.Uuid
  executionId String      @db.Uuid
  attempt     Int         @default(1)

  nodeId      String
  status      String
  message     String
  timestamp   DateTime

  execution   Execution   @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
}

// One logical HTTP action per node and execution. The key is stable across
// BullMQ deliveries; the remote service must honor it for automatic replay.
model HttpAction {
  id                 String              @id @default(uuid()) @db.Uuid
  executionId        String              @db.Uuid
  nodeId             String
  idempotencyKey     String              @unique
  requestFingerprint String
  status             String              @default("PENDING")
  response           Json?
  message            String?
  lastError          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  completedAt        DateTime?

  execution          Execution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  attempts           HttpActionAttempt[]

  @@unique([executionId, nodeId])
  @@index([status, updatedAt])
}

// A durable record of each outbound send. SENT is deliberately ambiguous
// after a crash: the remote call may have completed before the result was saved.
model HttpActionAttempt {
  id           String     @id @default(uuid()) @db.Uuid
  actionId     String     @db.Uuid
  number       Int
  status       String     @default("PREPARED")
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  error        String?

  action       HttpAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, number])
}
