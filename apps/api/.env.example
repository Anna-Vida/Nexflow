# NexFlow API environment
#
# Copy this file to .env for local development and replace values as needed.
# Never commit real credentials.

DATABASE_URL="postgresql://nexflow:nexflow@127.0.0.1:5433/nexflow"
REDIS_URL="redis://127.0.0.1:6379"
PORT=3000
NODE_ENV=development

# Browser/API origins used by OAuth redirects.
WEB_ORIGIN="http://localhost:5173"
API_ORIGIN="http://localhost:3000"

# Google OAuth 2.0 web application credentials.
# Authorized redirect URI:
# http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Optional isolated Redis database used by contract tests.
# TEST_REDIS_URL="redis://127.0.0.1:6379/15"
